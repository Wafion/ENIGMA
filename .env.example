# ==============================================================================
# ENIGMA Digital Documentary & Autonomous Investigation Platform
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local to configure your local environment.
# NEVER commit .env.local, API keys, or private secrets to source control.
#
# Obtain a Gemini API Key from Google AI Studio:
# https://aistudio.google.com/app/apikey
# ==============================================================================

# Gemini Autonomous Documentary Engine (gemini-3.8-flash)
# Used by the server-side cognitive synthesis pipeline to analyze archives,
# extract claims, detect contradictions, and synthesize documentary movements.
GEMINI_API_KEY=

# Optional: Alternative alias if using standard Google Cloud environment naming
# GOOGLE_API_KEY=

# Optional: Port for the standalone documentary orchestration server (default: 3001)
# PORT=3001

# Optional: Vite development configuration flag
VITE_CONFIG_NATIVE_IGNORE_WARNING=true
