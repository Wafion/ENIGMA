# ==============================================================================
# ENIGMA — Git Ignore Policy
# ==============================================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Build and Production Artifacts
dist/
dist-ssr/
build/
.vercel

# Environment and Secret Configurations
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.*
!.env.example
*.local

# Local SQLite Database & Backups
data/*.db
data/*.db-wal
data/*.db-shm
data/*.db.bak
data/backups/
!data/.gitkeep

# Development and Scratch Caches
.enigma-tmp/
.freebuff/
_backup_working_code/
.cloud-attachments/
.agents/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor and System Metadata
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.vercel
.env*
